# --- Cerebro (Claude) ---
# Clave de https://console.anthropic.com  (sin ella JARVIS funciona en modo comandos básico)
ANTHROPIC_API_KEY=
JARVIS_MODELO=claude-opus-5-5

# --- Correo ---
# Proveedor: gmail | outlook | yahoo | personalizado
CORREO_PROVEEDOR=gmail
CORREO_USUARIO=tu_correo@gmail.com
# En Gmail usa una "contraseña de aplicación" (Cuenta Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicación)
CORREO_CLAVE=
CORREO_NOMBRE=Tu Nombre
# Solo si CORREO_PROVEEDOR=personalizado
IMAP_HOST=
IMAP_PUERTO=993
SMTP_HOST=
SMTP_PUERTO=587

# --- Archivos ---
JARVIS_CARPETA_SALIDA=salidas

# --- Aprendizaje / memoria ---
# Dónde guarda JARVIS lo que aprende (notas, perfiles de tus hojas, índice de archivos)
JARVIS_DATOS=~/.jarvis
# Carpetas donde están tus hojas de trabajo (separadas por comas)
JARVIS_CARPETAS_TRABAJO=~/Documents,~/Desktop,~/Downloads

# --- Voz ---
# Voz de macOS (ver: say -v '?' | grep es_)  Ej: Paulina (México), Mónica (España), Jorge
JARVIS_VOZ=Paulina
# Modelo Whisper local para entender tu voz: tiny | base | small | medium
JARVIS_WHISPER_MODELO=small
