new file mode 100644
index 0000000..1798e33
--- /dev/null
+++ b/applications/services/gui/delfinos_nombres.h
@@ -0,0 +1,41 @@
+/**
+ * DelfínOS: nombres en español de las apps del sistema, SOLO para mostrarlos.
+ *
+ * El nombre interno (name= en application.fam) se queda en inglés porque con él
+ * abren las apps el celular, qFlipper, los atajos y los Favoritos.
+ */
+#pragma once
+
+#include <string.h>
+
+typedef struct {
+    const char* interno;
+    const char* visible;
+} DelfinosNombre;
+
+static const DelfinosNombre delfinos_nombres[] = {
+    {"Infrared", "Infrarrojo"},
+    {"Momentum", "DelfínOS"},
+    {"About", "Acerca de"},
+    {"Clock & Alarm", "Reloj y alarma"},
+    {"Desktop", "Escritorio"},
+    {"Expansion Modules", "Módulos externos"},
+    {"Input", "Botones"},
+    {"LCD and Notifications", "Pantalla y avisos"},
+    {"Passport", "Pasaporte"},
+    {"Power", "Energía"},
+    {"Storage", "Almacenamiento"},
+    {"System", "Sistema"},
+    {"Bluetooth Remote", "Mando Bluetooth"},
+    {"USB Remote", "Mando USB"},
+    {"JS Runner", "Ejecutar JS"},
+    {"FindMy Flipper", "Buscar Flipper"},
+};
+
+static inline const char* delfinos_nombre_visible(const char* interno) {
+    if(!interno) return interno;
+    for(size_t i = 0; i < sizeof(delfinos_nombres) / sizeof(delfinos_nombres[0]); i++) {
+        if(strcmp(interno, delfinos_nombres[i].interno) == 0) return delfinos_nombres[i].visible;
+    }
+    return interno;
+}
